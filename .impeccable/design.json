      "html": "<div class=\"ds-pane\" tabindex=\"0\"><pre class=\"ds-frame\" aria-hidden=\"true\">┌──────────────────────────────────────────┐\n│                                          │\n│                                          │\n│                                          │\n└──────────────────────────────────────────┘</pre><div class=\"ds-titles\"><span class=\"ds-t\">~ — zsh</span><span class=\"ds-r\">80×24</span></div><div class=\"ds-body\"><span class=\"u\">juan</span><span class=\"m\">@</span><span class=\"h\">udc</span><span class=\"m\">:</span><span class=\"p\">~</span><span class=\"m\">$ </span>neofetch</div></div>",
      "css": ":host{--bg:#1e1e2e;--mantle:#181825;--surface:#313244;--fg:#cdd6f4;--muted:#a6adc8;--red:#f38ba8;--orange:#fab387;--yellow:#f9e2af;--green:#a6e3a1;--cyan:#94e2d5;--blue:#89b4fa;--magenta:#cba6f7;--ease-out:cubic-bezier(0.16,1,0.3,1)} .ds-pane{font-family:'JetBrains Mono',ui-monospace,monospace;font-size:15px;line-height:24px;font-variant-ligatures:none;position:relative;width:44ch;height:120px;background:color-mix(in srgb,var(--mantle) 97%,transparent);color:var(--fg);box-shadow:0 18px 48px -18px rgb(0 0 0/.5)} .ds-frame{position:absolute;inset:0;margin:0;font:inherit;line-height:24px;color:color-mix(in srgb,var(--muted) 45%,transparent);transition:color .35s var(--ease-out)} .ds-pane:hover .ds-frame,.ds-pane:focus-within .ds-frame,.ds-pane:focus-visible .ds-frame{color:var(--green)} .ds-pane:focus-visible{outline:none} .ds-titles{position:absolute;top:0;left:2ch;right:2ch;display:flex;justify-content:space-between} .ds-t,.ds-r{background:var(--mantle);padding:0 1ch} .ds-t{font-weight:700} .ds-r{color:var(--muted)} .ds-body{position:absolute;top:24px;left:2ch} .u{color:var(--green);font-weight:700} .h{color:var(--blue);font-weight:700} .p{color:var(--cyan)} .m{color:var(--muted)}"
