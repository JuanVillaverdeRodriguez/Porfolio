      "css": ":host{--bg:#1e1e2e;--mantle:#181825;--surface:#313244;--fg:#cdd6f4;--muted:#a6adc8;--red:#f38ba8;--orange:#fab387;--yellow:#f9e2af;--green:#a6e3a1;--cyan:#94e2d5;--blue:#89b4fa;--magenta:#cba6f7;--ease-out:cubic-bezier(0.16,1,0.3,1)} .ds-btn-primary{font-family:'JetBrains Mono',ui-monospace,monospace;font-size:15px;line-height:24px;font-variant-ligatures:none;display:inline-block;text-decoration:none;font-weight:700;background:var(--green);color:var(--bg);padding:0 1ch;line-height:32px;border-radius:0;transition:background-color .2s var(--ease-out),transform .2s var(--ease-out)} .ds-btn-primary:hover{background:var(--yellow)} .ds-btn-primary:active{transform:translateY(1px)} .ds-btn-primary:focus-visible{outline:2px dashed var(--yellow);outline-offset:3px} .ds-btn-arrow{display:inline-block;transition:transform .25s var(--ease-out)} .ds-btn-primary:hover .ds-btn-arrow{transform:translateX(3px)}"
