      "css": ":host{--bg:#1e1e2e;--mantle:#181825;--surface:#313244;--fg:#cdd6f4;--muted:#a6adc8;--red:#f38ba8;--orange:#fab387;--yellow:#f9e2af;--green:#a6e3a1;--cyan:#94e2d5;--blue:#89b4fa;--magenta:#cba6f7;--ease-out:cubic-bezier(0.16,1,0.3,1)} .ds-field{font-family:'JetBrains Mono',ui-monospace,monospace;font-size:15px;line-height:24px;font-variant-ligatures:none;display:grid;grid-template-columns:10ch minmax(0,1fr);align-items:baseline;width:44ch;padding:8px;background:var(--mantle);color:var(--fg)} .ds-label{color:var(--magenta);font-weight:700} .ds-field input{font:inherit;color:inherit;background:transparent;border:0;border-bottom:1px dashed color-mix(in srgb,var(--muted) 45%,transparent);line-height:24px;padding:4px 0;caret-color:var(--green);border-radius:0;transition:border-color .2s} .ds-field input::placeholder{color:var(--muted);opacity:.85} .ds-field input:focus{outline:none;border-bottom:1px solid var(--green)} .ds-field:focus-within .ds-label{color:var(--green)}"
